{
  "name": "milewire",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @milewire/web",
    "dev:mobile": "npm run start -w @milewire/mobile",
    "build:web": "npm run build -w @milewire/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
